<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Weather Dashboard</title>

    <style>

        /* Interns: Add your CSS here */

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body { font-family: Arial, sans-serif; background: #f0f2f5; }

        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }

        /* Add more styles... */

    </style>

</head>

<body>

    <div class="container">

        <!-- Theme Toggle -->

        <div class="theme-toggle">

            <button id="themeBtn">🌙 Dark</button>

        </div>



        <!-- Search Section -->

        <div class="search-section">

            <input type="text" id="cityInput" placeholder="Enter city name..." />

            <button id="searchBtn">Search Weather</button>

        </div>



        <!-- Weather Display -->

        <div id="weatherCard" class="weather-card" style="display: none;"></div>

        

        <!-- Error Message -->

        <div id="errorMsg" class="error" style="display: none;"></div>



        <!-- Favorites -->

        <div class="favorites-section">

            <h3>Favorites</h3>

            <div id="favoritesList"></div>

        </div>

    </div>



    <script>

        // REPLACE THIS with your OpenWeatherMap API key (FREE signup)

        const API_KEY = 'da0e7a0836e0cfc675c7972a1520e40b';



        // 1. IMPLEMENT getWeather(city) - Fetch API + async/await

        async function getWeather(city) {

            try{
                //risky code
                let response = await fetch(`https://api.openweathermap.org/data/2.5/weather?q=${city}&appid=${API_KEY}&units=metric`);
                let data = await response.json();
                return data;
            }
            catch(error){
                console.error('Error fetching weather data:', error);
                throw error;
            }

            // TODO: Complete this function

        }



        // 2. IMPLEMENT addFavorite(city)

        async function addFavorite(city) {
            let favorites = JSON.parse(localStorage.getItem("favorites"))??[];//"favorites" is the key value in localstorage
            if(favorites.includes(city)){
                console.log("Already exists")
            }
            else{
                favorites.push(city);
                let fav = JSON.stringify(favorites);
                localStorage.setItem("favorites", fav);
            }
            // TODO: localStorage
            // + check duplicates

        }



        // 3. IMPLEMENT loadFavorites()

        function loadFavorites() {
            let fav1 = JSON.parse(localStorage.getItem("favorites"))??[];

            let favlist = document.getElementById("favoritesList");

            favlist.innerHTML = ""; // Clear existing favorites
            for(let value of fav1){
                favlist.innerHTML += `${value}<br>`;
            }

            // TODO: Display favorites from localStorage

        }



        // 4. IMPLEMENT searchWeather()

        async function searchWeather(city) {

            try{

            document.getElementById("errorMsg").style.display = "none";
            
            let loading = document.getElementById("weatherCard")
            loading.style.display = "block";
            loading.textContent = "Loading...";

            let weather = await getWeather(city);
            loading.innerHTML = `<h2>${weather.name}</h2>
            <p>Temperature: ${weather.main.temp} °C</p>
            <p>Weather: ${weather.weather[0].description}</p>`
            }
            
            catch(error){
                let errorMsg = document.getElementById("errorMsg");
                errorMsg.style.display = "block";
                errorMsg.textContent = "City not found";

                console.log(error)
                throw error;
            }

            // TODO: Show loading, call getWeather, handle errors

        }



        // 5. IMPLEMENT debounceSearch()

        let clock;

        function debounceSearch() {

            clearTimeout(clock);

            clock = setTimeout(()=>{
                searchWeather(document.getElementById("cityInput").value);//.value: give me the current text inside the input box.
            },500);
            // TODO: 500ms delay for search input

        };



        // 6. Event Listeners (wire up buttons/inputs)

        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById("searchBtn").addEventListener("click", function() {
                let city = document.getElementById("cityInput").value;
                searchWeather(city);
            });
        
        let themeBtn = document.getElementById("themeBtn");
        themeBtn.addEventListener("click",function(){

            if(document.body.style.backgroundColor === "black"){

                document.body.style.backgroundColor = "white";
                document.body.style.color = "black";
                themeBtn.textContent = "🌙 Dark";
            }
            else{
                document.body.style.backgroundColor = "black";
                document.body.style.color = "white";
                themeBtn.textContent = "☀️ Light";
            }
        })
            // TODO: Add your event listeners here

            loadFavorites();

        });



        // Export functions for button onclick (temporary)

        window.searchWeather = searchWeather;

        window.addFavorite = addFavorite;



        // //temp
        // getWeather("Kozhikode")
        // .then(data => console.log(data))
        // .catch(error => console.log(error));
    </script>

</body>

</html>

